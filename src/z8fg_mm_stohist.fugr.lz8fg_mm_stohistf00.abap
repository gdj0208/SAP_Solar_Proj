FORM CORR_MAINT_Z8V_MM_STOHIST USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE Z8V_MM_STOHIST-EBELN TO
Z8MM_STO_HIST-EBELN .
MOVE Z8V_MM_STOHIST-EBELP TO
Z8MM_STO_HIST-EBELP .
MOVE Z8V_MM_STOHIST-GJAHR TO
Z8MM_STO_HIST-GJAHR .
MOVE Z8V_MM_STOHIST-BELNR TO
Z8MM_STO_HIST-BELNR .
MOVE Z8V_MM_STOHIST-BUZEI TO
Z8MM_STO_HIST-BUZEI .
MOVE Z8V_MM_STOHIST-MANDT TO
Z8MM_STO_HIST-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'Z8MM_STO_HIST'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN Z8MM_STO_HIST TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'Z8MM_STO_HIST'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
