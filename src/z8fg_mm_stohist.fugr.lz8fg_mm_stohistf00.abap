FORM GET_DATA_Z8V_MM_STOHIST.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM Z8MM_STO_HIST WHERE
(VIM_WHERETAB) .
    CLEAR Z8V_MM_STOHIST .
Z8V_MM_STOHIST-MANDT =
Z8MM_STO_HIST-MANDT .
Z8V_MM_STOHIST-EBELN =
Z8MM_STO_HIST-EBELN .
Z8V_MM_STOHIST-EBELP =
Z8MM_STO_HIST-EBELP .
Z8V_MM_STOHIST-GJAHR =
Z8MM_STO_HIST-GJAHR .
Z8V_MM_STOHIST-BELNR =
Z8MM_STO_HIST-BELNR .
Z8V_MM_STOHIST-BUZEI =
Z8MM_STO_HIST-BUZEI .
Z8V_MM_STOHIST-BWART =
Z8MM_STO_HIST-BWART .
Z8V_MM_STOHIST-BUDAT =
Z8MM_STO_HIST-BUDAT .
Z8V_MM_STOHIST-MATNR =
Z8MM_STO_HIST-MATNR .
Z8V_MM_STOHIST-WERKS =
Z8MM_STO_HIST-WERKS .
Z8V_MM_STOHIST-LGORT =
Z8MM_STO_HIST-LGORT .
Z8V_MM_STOHIST-RESWK =
Z8MM_STO_HIST-RESWK .
Z8V_MM_STOHIST-RESLO =
Z8MM_STO_HIST-RESLO .
Z8V_MM_STOHIST-MENGE =
Z8MM_STO_HIST-MENGE .
Z8V_MM_STOHIST-MEINS =
Z8MM_STO_HIST-MEINS .
Z8V_MM_STOHIST-ERDAT =
Z8MM_STO_HIST-ERDAT .
Z8V_MM_STOHIST-ERZET =
Z8MM_STO_HIST-ERZET .
Z8V_MM_STOHIST-ERNAM =
Z8MM_STO_HIST-ERNAM .
<VIM_TOTAL_STRUC> = Z8V_MM_STOHIST.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_Z8V_MM_STOHIST .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO Z8V_MM_STOHIST.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_Z8V_MM_STOHIST-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM Z8MM_STO_HIST WHERE
  EBELN = Z8V_MM_STOHIST-EBELN AND
  EBELP = Z8V_MM_STOHIST-EBELP AND
  GJAHR = Z8V_MM_STOHIST-GJAHR AND
  BELNR = Z8V_MM_STOHIST-BELNR AND
  BUZEI = Z8V_MM_STOHIST-BUZEI .
    IF SY-SUBRC = 0.
    DELETE Z8MM_STO_HIST .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM Z8MM_STO_HIST WHERE
  EBELN = Z8V_MM_STOHIST-EBELN AND
  EBELP = Z8V_MM_STOHIST-EBELP AND
  GJAHR = Z8V_MM_STOHIST-GJAHR AND
  BELNR = Z8V_MM_STOHIST-BELNR AND
  BUZEI = Z8V_MM_STOHIST-BUZEI .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR Z8MM_STO_HIST.
    ENDIF.
Z8MM_STO_HIST-MANDT =
Z8V_MM_STOHIST-MANDT .
Z8MM_STO_HIST-EBELN =
Z8V_MM_STOHIST-EBELN .
Z8MM_STO_HIST-EBELP =
Z8V_MM_STOHIST-EBELP .
Z8MM_STO_HIST-GJAHR =
Z8V_MM_STOHIST-GJAHR .
Z8MM_STO_HIST-BELNR =
Z8V_MM_STOHIST-BELNR .
Z8MM_STO_HIST-BUZEI =
Z8V_MM_STOHIST-BUZEI .
Z8MM_STO_HIST-BWART =
Z8V_MM_STOHIST-BWART .
Z8MM_STO_HIST-BUDAT =
Z8V_MM_STOHIST-BUDAT .
Z8MM_STO_HIST-MATNR =
Z8V_MM_STOHIST-MATNR .
Z8MM_STO_HIST-WERKS =
Z8V_MM_STOHIST-WERKS .
Z8MM_STO_HIST-LGORT =
Z8V_MM_STOHIST-LGORT .
Z8MM_STO_HIST-RESWK =
Z8V_MM_STOHIST-RESWK .
Z8MM_STO_HIST-RESLO =
Z8V_MM_STOHIST-RESLO .
Z8MM_STO_HIST-MENGE =
Z8V_MM_STOHIST-MENGE .
Z8MM_STO_HIST-MEINS =
Z8V_MM_STOHIST-MEINS .
Z8MM_STO_HIST-ERDAT =
Z8V_MM_STOHIST-ERDAT .
Z8MM_STO_HIST-ERZET =
Z8V_MM_STOHIST-ERZET .
Z8MM_STO_HIST-ERNAM =
Z8V_MM_STOHIST-ERNAM .
    IF SY-SUBRC = 0.
    UPDATE Z8MM_STO_HIST ##WARN_OK.
    ELSE.
    INSERT Z8MM_STO_HIST .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_Z8V_MM_STOHIST-UPD_FLAG,
STATUS_Z8V_MM_STOHIST-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
