*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: Z8V_BRANCH_M....................................*
FORM GET_DATA_Z8V_BRANCH_M.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM Z8BRANCH_M WHERE
(VIM_WHERETAB) .
    CLEAR Z8V_BRANCH_M .
Z8V_BRANCH_M-MANDT =
Z8BRANCH_M-MANDT .
Z8V_BRANCH_M-BRANCH =
Z8BRANCH_M-BRANCH .
Z8V_BRANCH_M-BUKRS =
Z8BRANCH_M-BUKRS .
Z8V_BRANCH_M-NAME =
Z8BRANCH_M-NAME .
Z8V_BRANCH_M-KR_REPRES =
Z8BRANCH_M-KR_REPRES .
Z8V_BRANCH_M-KR_BUSTYPE =
Z8BRANCH_M-KR_BUSTYPE .
Z8V_BRANCH_M-KR_INDTYPE =
Z8BRANCH_M-KR_INDTYPE .
Z8V_BRANCH_M-STCD1 =
Z8BRANCH_M-STCD1 .
Z8V_BRANCH_M-ORT01 =
Z8BRANCH_M-ORT01 .
Z8V_BRANCH_M-STRAS =
Z8BRANCH_M-STRAS .
<VIM_TOTAL_STRUC> = Z8V_BRANCH_M.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_Z8V_BRANCH_M .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO Z8V_BRANCH_M.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_Z8V_BRANCH_M-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM Z8BRANCH_M WHERE
  BRANCH = Z8V_BRANCH_M-BRANCH AND
  BUKRS = Z8V_BRANCH_M-BUKRS .
    IF SY-SUBRC = 0.
    DELETE Z8BRANCH_M .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM Z8BRANCH_M WHERE
  BRANCH = Z8V_BRANCH_M-BRANCH AND
  BUKRS = Z8V_BRANCH_M-BUKRS .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR Z8BRANCH_M.
    ENDIF.
Z8BRANCH_M-MANDT =
Z8V_BRANCH_M-MANDT .
Z8BRANCH_M-BRANCH =
Z8V_BRANCH_M-BRANCH .
Z8BRANCH_M-BUKRS =
Z8V_BRANCH_M-BUKRS .
Z8BRANCH_M-NAME =
Z8V_BRANCH_M-NAME .
Z8BRANCH_M-KR_REPRES =
Z8V_BRANCH_M-KR_REPRES .
Z8BRANCH_M-KR_BUSTYPE =
Z8V_BRANCH_M-KR_BUSTYPE .
Z8BRANCH_M-KR_INDTYPE =
Z8V_BRANCH_M-KR_INDTYPE .
Z8BRANCH_M-STCD1 =
Z8V_BRANCH_M-STCD1 .
Z8BRANCH_M-ORT01 =
Z8V_BRANCH_M-ORT01 .
Z8BRANCH_M-STRAS =
Z8V_BRANCH_M-STRAS .
    IF SY-SUBRC = 0.
    UPDATE Z8BRANCH_M ##WARN_OK.
    ELSE.
    INSERT Z8BRANCH_M .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_Z8V_BRANCH_M-UPD_FLAG,
STATUS_Z8V_BRANCH_M-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
