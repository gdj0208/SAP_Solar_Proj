   <FUNCTIONS>
    <item>
     <FUNCNAME>Z8FI_POST_INSPECTION</FUNCNAME>
     <SHORT_TEXT>고객 검수 시 자동 FI 전표 생성</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_PRO_ID</PARAMETER>
       <REFERENCE>X</REFERENCE>
       <TYP>Z8PS_PROJECT-PRO_ID</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>EV_BELNR</PARAMETER>
       <REFERENCE>X</REFERENCE>
       <TYP>Z8FI_ACCDOC_H-BELNR</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_GJAHR</PARAMETER>
       <REFERENCE>X</REFERENCE>
       <TYP>Z8FI_ACCDOC_H-GJAHR</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_RETURN</PARAMETER>
       <REFERENCE>X</REFERENCE>
       <TYP>SY-SUBRC</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_MESSAGE</PARAMETER>
       <REFERENCE>X</REFERENCE>
       <TYP>STRING</TYP>
      </RSEXP>
     </EXPORT>
     <EXCEPTION>
      <RSEXC>
       <EXCEPTION>PROJECT_NOT_FOUND</EXCEPTION>
      </RSEXC>
      <RSEXC>
       <EXCEPTION>INSPECTION_NOT_COMPLETED</EXCEPTION>
      </RSEXC>
      <RSEXC>
       <EXCEPTION>DATA_ERROR</EXCEPTION>
      </RSEXC>
      <RSEXC>
       <EXCEPTION>ALREADY_POSTED</EXCEPTION>
      </RSEXC>
      <RSEXC>
       <EXCEPTION>INVALID_AMOUNT</EXCEPTION>
      </RSEXC>
      <RSEXC>
       <EXCEPTION>POSTING_FAILED</EXCEPTION>
      </RSEXC>
     </EXCEPTION>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IV_PRO_ID</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Project ID</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_BELNR</PARAMETER>
       <KIND>P</KIND>
       <STEXT>전표 번호</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_GJAHR</PARAMETER>
       <KIND>P</KIND>
       <STEXT>회계연도</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_RETURN</PARAMETER>
       <KIND>P</KIND>
       <STEXT>ABAP System Field: Return Code of ABAP Statements</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_MESSAGE</PARAMETER>
       <KIND>P</KIND>
       <STEXT>오퍼랜드값에 대한 네번째 키필드</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>PROJECT_NOT_FOUND</PARAMETER>
       <KIND>X</KIND>
       <STEXT>프로젝트 정보를 찾을 수 없습니다.</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>INSPECTION_NOT_COMPLETED</PARAMETER>
       <KIND>X</KIND>
       <STEXT>고객 검수가 완료되지 않은 프로젝트 입니다.</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>DATA_ERROR</PARAMETER>
       <KIND>X</KIND>
       <STEXT>전표 생성에 필요한 참조 정보를 확인할 수 없습니다.</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ALREADY_POSTED</PARAMETER>
       <KIND>X</KIND>
       <STEXT>이미 검수완료 회계전표가 생성된 프로젝트입니다.</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>INVALID_AMOUNT</PARAMETER>
       <KIND>X</KIND>
       <STEXT>전표 생성 금액이 올바르지 않습니다.</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>POSTING_FAILED</PARAMETER>
       <KIND>X</KIND>
       <STEXT>회계전표 생성 중 오류가 발생했습니다.</STEXT>
      </RSFDO>
     </DOCUMENTATION>
