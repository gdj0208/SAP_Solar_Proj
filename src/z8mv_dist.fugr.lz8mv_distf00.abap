*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: Z8V_DISTANCE....................................*
FORM GET_DATA_Z8V_DISTANCE.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM Z8DISTANCE_M WHERE
(VIM_WHERETAB) .
    CLEAR Z8V_DISTANCE .
Z8V_DISTANCE-MANDT =
Z8DISTANCE_M-MANDT .
Z8V_DISTANCE-DISTANCE_RATE_ID =
Z8DISTANCE_M-DISTANCE_RATE_ID .
Z8V_DISTANCE-WERKS =
Z8DISTANCE_M-WERKS .
Z8V_DISTANCE-REGION_CODE =
Z8DISTANCE_M-REGION_CODE .
Z8V_DISTANCE-KBETR =
Z8DISTANCE_M-KBETR .
Z8V_DISTANCE-WAERS =
Z8DISTANCE_M-WAERS .
Z8V_DISTANCE-DATAB =
Z8DISTANCE_M-DATAB .
Z8V_DISTANCE-DATBI =
Z8DISTANCE_M-DATBI .
Z8V_DISTANCE-STATUS =
Z8DISTANCE_M-STATUS .
    SELECT SINGLE * FROM Z8PLANT_M WHERE
WERKS = Z8DISTANCE_M-WERKS .
    IF SY-SUBRC EQ 0.
    ENDIF.
    SELECT SINGLE * FROM Z8REGION_M WHERE
REGION_CODE = Z8DISTANCE_M-REGION_CODE .
    IF SY-SUBRC EQ 0.
    ENDIF.
<VIM_TOTAL_STRUC> = Z8V_DISTANCE.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_Z8V_DISTANCE .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO Z8V_DISTANCE.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_Z8V_DISTANCE-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM Z8DISTANCE_M WHERE
  DISTANCE_RATE_ID = Z8V_DISTANCE-DISTANCE_RATE_ID .
    IF SY-SUBRC = 0.
    DELETE Z8DISTANCE_M .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM Z8DISTANCE_M WHERE
  DISTANCE_RATE_ID = Z8V_DISTANCE-DISTANCE_RATE_ID .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR Z8DISTANCE_M.
    ENDIF.
Z8DISTANCE_M-MANDT =
Z8V_DISTANCE-MANDT .
Z8DISTANCE_M-DISTANCE_RATE_ID =
Z8V_DISTANCE-DISTANCE_RATE_ID .
Z8DISTANCE_M-WERKS =
Z8V_DISTANCE-WERKS .
Z8DISTANCE_M-REGION_CODE =
Z8V_DISTANCE-REGION_CODE .
Z8DISTANCE_M-KBETR =
Z8V_DISTANCE-KBETR .
Z8DISTANCE_M-WAERS =
Z8V_DISTANCE-WAERS .
Z8DISTANCE_M-DATAB =
Z8V_DISTANCE-DATAB .
Z8DISTANCE_M-DATBI =
Z8V_DISTANCE-DATBI .
Z8DISTANCE_M-STATUS =
Z8V_DISTANCE-STATUS .
    IF SY-SUBRC = 0.
    UPDATE Z8DISTANCE_M ##WARN_OK.
    ELSE.
    INSERT Z8DISTANCE_M .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_Z8V_DISTANCE-UPD_FLAG,
STATUS_Z8V_DISTANCE-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
