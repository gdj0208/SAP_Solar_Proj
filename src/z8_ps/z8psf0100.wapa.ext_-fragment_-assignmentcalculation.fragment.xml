<core:FragmentDefinition                                                                                                                                                                                                                                       
    xmlns="sap.m"                                                                                                                                                                                                                                              
    xmlns:core="sap.ui.core">                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
    <VBox                                                                                                                                                                                                                                                      
        id="calcMainBox"                                                                                                                                                                                                                                       
        width="100%"                                                                                                                                                                                                                                           
        class="sapUiSmallMargin">                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        <!-- 안내 문구 -->                                                                                                                                                                                                                                         
        <Text                                                                                                                                                                                                                                                  
            id="calcDescription"                                                                                                                                                                                                                               
            text="선택한 인력의 일일 시공능력을 기준으로 산정한 결과입니다."                                                                                                                                                                                                            
            class="sapUiSmallMarginBottom" />                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        <!-- 핵심 지표 6개 -->                                                                                                                                                                                                                                      
        <FlexBox                                                                                                                                                                                                                                               
            id="calcResultBox"                                                                                                                                                                                                                                 
            width="100%"                                                                                                                                                                                                                                       
            wrap="Wrap"                                                                                                                                                                                                                                        
            justifyContent="SpaceBetween"                                                                                                                                                                                                                      
            class="sapUiMediumMarginTop sapUiMediumMarginBottom">                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            <VBox id="calcAreaBox"                                                                                                                                                                                                                             
                  width="14rem"                                                                                                                                                                                                                                
                  class="sapUiSmallMarginBottom">                                                                                                                                                                                                              
                <Label id="lblTotalArea" text="설치면적" />                                                                                                                                                                                                        
                <Title id="txtTotalArea"                                                                                                                                                                                                                       
                       text="{calc>/totalArea}"                                                                                                                                                                                                                
                       level="H4" />                                                                                                                                                                                                                           
            </VBox>                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            <VBox id="calcInstallBox"                                                                                                                                                                                                                          
                  width="14rem"                                                                                                                                                                                                                                
                  class="sapUiSmallMarginBottom">                                                                                                                                                                                                              
                <Label id="lblInstallCount" text="선택 설치기사" />                                                                                                                                                                                                  
                <Title id="txtInstallCount"                                                                                                                                                                                                                    
                       text="{calc>/installCount}"                                                                                                                                                                                                             
                       level="H4" />                                                                                                                                                                                                                           
            </VBox>                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            <VBox id="calcElecBox"                                                                                                                                                                                                                             
                  width="14rem"                                                                                                                                                                                                                                
                  class="sapUiSmallMarginBottom">                                                                                                                                                                                                              
                <Label id="lblElecCount" text="선택 전기기사" />                                                                                                                                                                                                     
                <Title id="txtElecCount"                                                                                                                                                                                                                       
                       text="{calc>/elecCount}"                                                                                                                                                                                                                
                       level="H4" />                                                                                                                                                                                                                           
            </VBox>                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            <VBox id="calcCapacityBox"                                                                                                                                                                                                                         
                  width="14rem"                                                                                                                                                                                                                                
                  class="sapUiSmallMarginBottom">                                                                                                                                                                                                              
                <Label id="lblDailyCapacity"                                                                                                                                                                                                                   
                       text="일일 시공 가능 면적" />                                                                                                                                                                                                                   
                <Title id="txtDailyCapacity"                                                                                                                                                                                                                   
                       text="{calc>/dailyCapacity}"                                                                                                                                                                                                            
                       level="H4" />                                                                                                                                                                                                                           
            </VBox>                                                                                                                                                                                                                                            
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                       
            <VBox id="calcWorkDaysBox"                                                                                                                                                                                                                         
                  width="14rem"                                                                                                                                                                                                                                
                  class="sapUiSmallMarginBottom">                                                                                                                                                                                                              
                <Label id="lblWorkDays" text="계획 공사일수" />                                                                                                                                                                                                      
                <Title id="txtWorkDays"                                                                                                                                                                                                                        
                       text="{calc>/workDays}"                                                                                                                                                                                                                 
                       level="H4" />                                                                                                                                                                                                                           
            </VBox>                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            <VBox id="calcExpectedBox"                                                                                                                                                                                                                         
                  width="14rem"                                                                                                                                                                                                                                
                  class="sapUiSmallMarginBottom">                                                                                                                                                                                                              
                <Label id="lblExpectedDays"                                                                                                                                                                                                                    
                       text="예상 작업일수" />                                                                                                                                                                                                                       
                <Title id="txtExpectedDays"                                                                                                                                                                                                                    
                       text="{calc>/expectedDays}"                                                                                                                                                                                                             
                       level="H4" />                                                                                                                                                                                                                           
            </VBox>                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        </FlexBox>                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
        <!-- 판정 결과와 배정 확정 -->                                                                                                                                                                                                                                  
        <HBox                                                                                                                                                                                                                                                  
            id="confirmButtonBox"                                                                                                                                                                                                                              
            width="100%"                                                                                                                                                                                                                                       
            alignItems="Center"                                                                                                                                                                                                                                
            justifyContent="SpaceBetween"                                                                                                                                                                                                                      
            class="sapUiMediumMarginTop"                                                                                                                                                                                                                       
            core:require="{handler: 'z8/ps/z8psf0100/ext/controller/AssignStaff'}">                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            <VBox id="calcStatusBox">                                                                                                                                                                                                                          
                <Label                                                                                                                                                                                                                                         
                    id="lblCalcResult"                                                                                                                                                                                                                         
                    text="최종 판정" />                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                <ObjectStatus                                                                                                                                                                                                                                  
                    id="calcResultStatus"                                                                                                                                                                                                                      
                    text="{calc>/resultText}"                                                                                                                                                                                                                  
                    state="{calc>/resultState}" />                                                                                                                                                                                                             
            </VBox>                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            <Button                                                                                                                                                                                                                                            
                id="btnConfirmAssignment"                                                                                                                                                                                                                      
                text="배정 확정"                                                                                                                                                                                                                                   
                type="Emphasized"                                                                                                                                                                                                                              
                class="sapUiMediumMarginEnd"                                                                                                                                                                                                                   
                enabled="{= ${calc>/calculated} === true &amp;&amp; ${calc>/canConfirm} === true }"                                                                                                                                                            
                press="handler.onConfirmAssignment" />                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
        </HBox>                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
    </VBox>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
</core:FragmentDefinition>                                                                                                                                                                                                                                     