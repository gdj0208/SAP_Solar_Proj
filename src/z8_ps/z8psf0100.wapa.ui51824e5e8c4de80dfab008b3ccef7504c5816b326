sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/mvc/ControllerExtension"                                                                                                                                                                                                                      
], function (ControllerExtension) {                                                                                                                                                                                                                            
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    return ControllerExtension.extend(                                                                                                                                                                                                                         
        "z8.ps.z8psf0100.ext.controller.ProjectObjectPageExt",                                                                                                                                                                                                 
		                                                                                                                                                                                                                                                             
        {                                                                                                                                                                                                                                                      
            override: {                                                                                                                                                                                                                                        
				                                                                                                                                                                                                                                                           
				routing: {                                                                                                                                                                                                                                                 
					onBeforeBinding: function (oBindingContext) {                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
						const oCalcModel = this.base.getView().getModel("calc");                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
						if (!oCalcModel) {                                                                                                                                                                                                                                       
							return;                                                                                                                                                                                                                                                 
						}                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
						// 프로젝트 이동 시 이전 계산 상태 초기화                                                                                                                                                                                                                                
						oCalcModel.setProperty("/calculated", false);                                                                                                                                                                                                            
						oCalcModel.setProperty("/canConfirm", false);                                                                                                                                                                                                            
						oCalcModel.setProperty("/hasSelection", false);                                                                                                                                                                                                          
					}                                                                                                                                                                                                                                                         
				},                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				// Object Page의 화면 랜더링이 끝난 뒤 호출되는 생명주기 함수                                                                                                                                                                                                                  
                onAfterRendering: function () {                                                                                                                                                                                                                
                    // 테이블이 이미 생성됐다면 즉시 연결                                                                                                                                                                                                                     
                    this._attachTableEvents(); // 화면에 설치기사, 전기기사 테이블이 만들어져있는지 확인 -> 만들어져 있다면 선택 이벤트 등                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // 테이블이 나중에 생성되는 경우를 처리                                                                                                                                                                                                                    
                    if (!this._oObserver && !this._bBothAttached) {                                                                                                                                                                                            
                        this._oObserver = new MutationObserver( // 테이블이 나중에 나타나는지 감시                                                                                                                                                                           
                            this._attachTableEvents.bind(this)                                                                                                                                                                                                 
                        );                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                        this._oObserver.observe(document.body, {                                                                                                                                                                                               
                            childList: true,                                                                                                                                                                                                                   
                            subtree: true                                                                                                                                                                                                                      
                        });                                                                                                                                                                                                                                    
                    }                                                                                                                                                                                                                                          
                },                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                onExit: function () {                                                                                                                                                                                                                          
                    if (this._oObserver) {                                                                                                                                                                                                                     
                        this._oObserver.disconnect();                                                                                                                                                                                                          
                        this._oObserver = null;                                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    if (this._oInstallTable) {                                                                                                                                                                                                                 
                        this._oInstallTable.detachSelectionChange(                                                                                                                                                                                             
                            this._onSelectionChanged,                                                                                                                                                                                                          
                            this                                                                                                                                                                                                                               
                        );                                                                                                                                                                                                                                     
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    if (this._oElecTable) {                                                                                                                                                                                                                    
                        this._oElecTable.detachSelectionChange(                                                                                                                                                                                                
                            this._onSelectionChanged,                                                                                                                                                                                                          
                            this                                                                                                                                                                                                                               
                        );                                                                                                                                                                                                                                     
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
			onAvailableStaffRebind: function (oEvent) {                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
				// 이벤트를 발생시킨 객체                                                                                                                                                                                                                                            
				const oSource = oEvent.getSource();                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
				// 객체 식별 정보 확인                                                                                                                                                                                                                                             
				const sId = oSource && oSource.getId                                                                                                                                                                                                                       
					? oSource.getId()                                                                                                                                                                                                                                         
					: "(ID 없음)";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
				const sType = oSource && oSource.getMetadata                                                                                                                                                                                                               
					? oSource.getMetadata().getName()                                                                                                                                                                                                                         
					: "(타입 없음)";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
				const bHasSelectionEvent = !!(                                                                                                                                                                                                                             
					oSource &&                                                                                                                                                                                                                                                
					typeof oSource.attachSelectionChange === "function"                                                                                                                                                                                                       
				);                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				console.log("[PS] beforeRebindTable 실행", {                                                                                                                                                                                                                 
					id: sId,                                                                                                                                                                                                                                                  
					type: sType,                                                                                                                                                                                                                                              
					supportsSelectionChange: bHasSelectionEvent                                                                                                                                                                                                               
				});                                                                                                                                                                                                                                                        
			},                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            _attachTableEvents: function () {                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
				// 1. 현재 Object Page의 View 객체                                                                                                                                                                                                                              
				const oView = this.base.getView();                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				// 2. 현재 View에서 테이블 찾기                                                                                                                                                                                                                                     
				const oInstall = oView.byId(                                                                                                                                                                                                                               
					"fe::table::_AvailableInstall::LineItem"                                                                                                                                                                                                                  
				);                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				const oElec = oView.byId(                                                                                                                                                                                                                                  
					"fe::table::_AvailableElec::LineItem"                                                                                                                                                                                                                     
				);                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				// 3. 설치기사 테이블 이벤트 연결                                                                                                                                                                                                                                      
				if (oInstall && !this._oInstallTable) {                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
					oInstall.attachSelectionChange( // SAPUI5 테이블이 제공하는 기능                                                                                                                                                                                                    
						this._onSelectionChanged,                                                                                                                                                                                                                                
						this                                                                                                                                                                                                                                                     
					);                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
					this._oInstallTable = oInstall;                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
					console.log("[PS] 설치기사 선택 이벤트 연결");                                                                                                                                                                                                                       
				}                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
				// 4. 전기기사 테이블 이벤트 연결                                                                                                                                                                                                                                      
				if (oElec && !this._oElecTable) {                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
					oElec.attachSelectionChange(                                                                                                                                                                                                                              
						this._onSelectionChanged,                                                                                                                                                                                                                                
						this                                                                                                                                                                                                                                                     
					);                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
					this._oElecTable = oElec;                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
					console.log("[PS] 전기기사 선택 이벤트 연결");                                                                                                                                                                                                                       
				}                                                                                                                                                                                                                                                          
				                                                                                                                                                                                                                                                           
				// 5. 두 테이블 모두 연결되었으면                                                                                                                                                                                                                                      
				if (this._oInstallTable && this._oElecTable) {                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
					this._bBothAttached = true;                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
					if (this._oObserver) {                                                                                                                                                                                                                                    
						this._oObserver.disconnect();                                                                                                                                                                                                                            
						this._oObserver = null;                                                                                                                                                                                                                                  
					}                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
					// 현재 선택 상태를 calc 모델에 반영                                                                                                                                                                                                                                  
					this._onSelectionChanged();                                                                                                                                                                                                                               
				}                                                                                                                                                                                                                                                          
				                                                                                                                                                                                                                                                           
			},                                                                                                                                                                                                                                                          
            _onSelectionChanged: function () {                                                                                                                                                                                                                 
                const oCalcModel = this.base.getView().getModel("calc");                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                if (!oCalcModel) {                                                                                                                                                                                                                             
                    console.warn("[PS] calc 모델을 찾지 못함");                                                                                                                                                                                                       
                    return;                                                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                const nInstall = this._oInstallTable                                                                                                                                                                                                           
                    ? this._oInstallTable.getSelectedContexts().length                                                                                                                                                                                         
                    : 0;                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                const nElec = this._oElecTable                                                                                                                                                                                                                 
                    ? this._oElecTable.getSelectedContexts().length                                                                                                                                                                                            
                    : 0;                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                const bHasSelection = (nInstall + nElec) > 0; // 선택 된 인원이 1명 이상이면 bHasSelection = true                                                                                                                                                         
                                                                                                                                                                                                                                                               
                oCalcModel.setProperty(                                                                                                                                                                                                                        
                    "/hasSelection",                                                                                                                                                                                                                           
                    bHasSelection                                                                                                                                                                                                                              
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                // 직원 선택이 변경되면 이전 계산 결과 무효화                                                                                                                                                                                                                    
                oCalcModel.setProperty("/calculated", false);                                                                                                                                                                                                  
				oCalcModel.setProperty("/canConfirm", false);                                                                                                                                                                                                              
				                                                                                                                                                                                                                                                           
				const setSection = oCalcModel.getProperty("/calculated");                                                                                                                                                                                                  
				if(setSection === false) {                                                                                                                                                                                                                                 
					                                                                                                                                                                                                                                                          
				}                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
				/**                                                                                                                                                                                                                                                        
				 * oExtensionAPI: Fiori Elements 확장 API ->선택된 행 조회 등 FE 기능 제공                                                                                                                                                                                              
				 * oView: 화면(View) 객체 -> 화면 ID 생성, 화면 모델 접근 등                                                                                                                                                                                                              
				 * oView를 통해 화면의 Id를 만들고, oExtensionAPI를 통해 그 테이블의 선택 데이터를 읽는                                                                                                                                                                                              
				 */                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                // Object Page ExtensionAPI                                                                                                                                                                                                                    
				const oExtensionAPI = this.base.getExtensionAPI();                                                                                                                                                                                                         
				const oView = this.base.getView();                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				// 현재 View 기준으로 테이블 ID 생성                                                                                                                                                                                                                                  
				const sInstallId = oView.createId(                                                                                                                                                                                                                         
					"fe::table::_AvailableInstall::LineItem"                                                                                                                                                                                                                  
				);                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				const sElecId = oView.createId(                                                                                                                                                                                                                            
					"fe::table::_AvailableElec::LineItem"                                                                                                                                                                                                                     
				);                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				// 선택된 행 조회 (공식 API)                                                                                                                                                                                                                                       
				const aInstallByAPI = oExtensionAPI.getSelectedContexts(sInstallId); // sInstallId에 해당하는 테이블에서 현재 선택된 행들의 Context를 반환                                                                                                                                      
				const aElecByAPI = oExtensionAPI.getSelectedContexts(sElecId);                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
				console.log(                                                                                                                                                                                                                                               
					"[PS] ExtensionAPI 설치기사:",                                                                                                                                                                                                                                
					aInstallByAPI.map(oContext =>                                                                                                                                                                                                                             
						oContext.getProperty("PersonalNumber")                                                                                                                                                                                                                   
					)                                                                                                                                                                                                                                                         
				);                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				console.log(                                                                                                                                                                                                                                               
					"[PS] ExtensionAPI 전기기사:",                                                                                                                                                                                                                                
					aElecByAPI.map(oContext =>                                                                                                                                                                                                                                
						oContext.getProperty("PersonalNumber")                                                                                                                                                                                                                   
					)                                                                                                                                                                                                                                                         
				);                                                                                                                                                                                                                                                         
            }                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
    );                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            