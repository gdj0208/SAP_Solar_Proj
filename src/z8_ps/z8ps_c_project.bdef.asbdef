projection;
strict ( 2 );

define behavior for Z8PS_C_PROJECT //alias <alias_name>
{
  use update;

  use association _Tech; // { create; } -> Tech_Hist 행을 사용자가 직접 추가 하는 구조 X
  //Fiori/OData 소비자가 _Tech child에 대해 직접 create 요청을 보낼 수 있게 공개하는 의미가 됨
  // = TechHist 관계는 노출, 하지만 직접 create는 공개 안 함

  use action confirmationAssignment;
}

define behavior for Z8PS_C_TECH_HIST //alias <alias_name>
{
  use association _Project;
}