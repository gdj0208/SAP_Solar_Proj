sap.ui.define([                                                                                                                                                                                                                                                
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/ui/core/Element"                                                                                                                                                                                                                                      
], function (MessageBox, Element) {                                                                                                                                                                                                                            
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        onAssignStaff: function (oContext, aSelectedContexts) {                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 1. 현재 프로젝트 Context 확인                                                                                                                                                                                                                           
            if (!oContext) {                                                                                                                                                                                                                                   
                MessageBox.error("프로젝트 정보를 가져올 수 없습니다.");                                                                                                                                                                                                      
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 2. 선택된 설치기사 조회                                                                                                                                                                                                                                  
            const aInstall = this.getSelectedContexts(                                                                                                                                                                                                         
                "fe::table::_AvailableInstall::LineItem"                                                                                                                                                                                                       
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 3. 선택된 전기기사 조회                                                                                                                                                                                                                                  
            const aElec = this.getSelectedContexts(                                                                                                                                                                                                            
                "fe::table::_AvailableElec::LineItem"                                                                                                                                                                                                          
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 4. 선택된 직원번호 추출                                                                                                                                                                                                                                  
            const aInstallPernr = aInstall.map(function (oRow) {                                                                                                                                                                                               
                return oRow.getProperty("PersonalNumber");                                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const aElecPernr = aElec.map(function (oRow) {                                                                                                                                                                                                     
                return oRow.getProperty("PersonalNumber");                                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 아무도 선택하지 않은 경우                                                                                                                                                                                                                                  
            if (aInstall.length + aElec.length === 0) {                                                                                                                                                                                                        
                MessageBox.warning("배정할 직원을 선택해주세요.");                                                                                                                                                                                                         
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 5. 프로젝트 정보 조회                                                                                                                                                                                                                                   
            const sProjectId = oContext.getProperty("ProjectId");                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            if (!sProjectId) {                                                                                                                                                                                                                                 
                MessageBox.error("프로젝트 번호를 확인할 수 없습니다.");                                                                                                                                                                                                      
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            const nTotalArea = Number(                                                                                                                                                                                                                         
                oContext.getProperty("TotalArea")                                                                                                                                                                                                              
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            const nWorkDays = Number(                                                                                                                                                                                                                          
                oContext.getProperty("WorkDays")                                                                                                                                                                                                               
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 프로젝트 기본값 검증                                                                                                                                                                                                                                     
            if (                                                                                                                                                                                                                                               
                !Number.isFinite(nTotalArea) || nTotalArea <= 0 ||                                                                                                                                                                                             
                !Number.isFinite(nWorkDays) || nWorkDays <= 0                                                                                                                                                                                                  
            ) {                                                                                                                                                                                                                                                
                MessageBox.error(                                                                                                                                                                                                                              
                    "프로젝트 설치면적 또는 계획 공사일수를 확인할 수 없습니다."                                                                                                                                                                                                        
                );                                                                                                                                                                                                                                             
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 6. 선택한 설치기사들의 일일 생산성 조회                                                                                                                                                                                                                         
            const aCapacities = aInstall.map(function (oRow) {                                                                                                                                                                                                 
                return Number(oRow.getProperty("Capacity"));                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 생산성 값이 모두 유효한지 확인                                                                                                                                                                                                                               
            const bCapacityValid = aCapacities.every(function (nCapacity) {                                                                                                                                                                                    
                return Number.isFinite(nCapacity) && nCapacity >= 0;                                                                                                                                                                                           
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 생산성 합계                                                                                                                                                                                                                                          
            const nDailyCapacity = aCapacities.reduce(                                                                                                                                                                                                         
                function (nSum, nCapacity) {                                                                                                                                                                                                                   
                    return nSum + nCapacity;                                                                                                                                                                                                                   
                },                                                                                                                                                                                                                                             
                0                                                                                                                                                                                                                                              
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 7. 예상 작업일수 계산                                                                                                                                                                                                                                   
            const nExpectedDays =                                                                                                                                                                                                                              
                bCapacityValid && nDailyCapacity > 0                                                                                                                                                                                                           
                    ? Math.ceil(nTotalArea / nDailyCapacity)                                                                                                                                                                                                   
                    : null;                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            // 8. 배정 조건 판정                                                                                                                                                                                                                                     
            const bElecOK = aElec.length >= 1;                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            const bPeriodOK =                                                                                                                                                                                                                                  
                nExpectedDays !== null &&                                                                                                                                                                                                                      
                nExpectedDays <= nWorkDays;                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            const bCanAssign = bElecOK && bPeriodOK; // 전기기사 최소 1명 이상 선택 && 기존 공사 예상일 < 인력 배정 후 공사 예상일                                                                                                                                                         
                                                                                                                                                                                                                                                               
            // 9. 배정 불가 사유 생성                                                                                                                                                                                                                                  
            const aReasons = [];                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            if (                                                                                                                                                                                                                                               
                aInstall.length === 0 ||                                                                                                                                                                                                                       
                !bCapacityValid ||                                                                                                                                                                                                                             
                nDailyCapacity <= 0                                                                                                                                                                                                                            
            ) {                                                                                                                                                                                                                                                
                aReasons.push("설치기사 작업능력 부족");                                                                                                                                                                                                                 
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (!bElecOK) {                                                                                                                                                                                                                                    
                aReasons.push("전기기사 최소 1명 필요");                                                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (nExpectedDays !== null && !bPeriodOK) {                                                                                                                                                                                                        
                aReasons.push("추가 인력 배정 필요 (계획 공사일수 초과)");                                                                                                                                                                                                     
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 10. 계산 결과 문자열 생성                                                                                                                                                                                                                                
            const sResultText = bCanAssign                                                                                                                                                                                                                     
                ? "배정 가능"                                                                                                                                                                                                                                      
                : "배정 불가: " + aReasons.join(", ");                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            const sResultState = bCanAssign                                                                                                                                                                                                                    
                ? "Success"                                                                                                                                                                                                                                    
                : "Error";                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            // 11. calc JSON Model 가져오기                                                                                                                                                                                                                        
            const oCalcModel = this.getModel("calc");                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            if (!oCalcModel) {                                                                                                                                                                                                                                 
                MessageBox.error("배정안 계산 모델을 찾을 수 없습니다.");                                                                                                                                                                                                     
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 12. 계산 결과를 JSON Model에 저장                                                                                                                                                                                                                       
            oCalcModel.setData({                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                calculated: true,                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                totalArea: nTotalArea + "㎡",                                                                                                                                                                                                                   
                workDays: nWorkDays + "일",                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                installCount: aInstall.length + "명",                                                                                                                                                                                                           
                elecCount: aElec.length + "명",                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                dailyCapacity: bCapacityValid                                                                                                                                                                                                                  
                    ? nDailyCapacity + "㎡/일"                                                                                                                                                                                                                   
                    : "확인 필요",                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                expectedDays: nExpectedDays === null                                                                                                                                                                                                           
                    ? "계산 불가"                                                                                                                                                                                                                                  
                    : nExpectedDays + "일",                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                resultText: sResultText,                                                                                                                                                                                                                       
                resultState: sResultState,                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                // 다음 단계의 배정 확정에서 활용할 값                                                                                                                                                                                                                        
                canConfirm: bCanAssign,                                                                                                                                                                                                                        
                projectId: sProjectId,                                                                                                                                                                                                                         
                // installPernrs: aInstallPernr,                                                                                                                                                                                                               
                // elecPernrs: aElecPernr                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            }, true);                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            // 직원번호 배열은 병합하지 않고 교체                                                                                                                                                                                                                             
            oCalcModel.setProperty("/installPernrs", [...aInstallPernr]);                                                                                                                                                                                      
            oCalcModel.setProperty("/elecPernrs", [...aElecPernr]);                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                       
            setTimeout(() => {                                                                                                                                                                                                                                 
                // 섹션을 관리하는 상위 컨트롤                                                                                                                                                                                                                             
                const oSection = this.byId("fe::CustomSection::AssignmentCalculation");                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                if (oSection) {                                                                                                                                                                                                                                
                    oSection.getParent().setSelectedSection(oSection.getId()); //계산 탭 선                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
            }, 300);                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            console.log(                                                                                                                                                                                                                                       
                "[PS] 배정안 계산 결과:",                                                                                                                                                                                                                             
                oCalcModel.getData()                                                                                                                                                                                                                           
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onConfirmAssignment: function (oEvent) {                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            // 1. 버튼이 접근할 수 있는 calc 모델                                                                                                                                                                                                                         
            // 배정확정 버튼을 통해 calc 모델을 가져옴 (json에 등록한 정보)                                                                                                                                                                                                         
            /**                                                                                                                                                                                                                                                
             * oEvent.getSource(): 이 이벤트를 발생시킨 컨트롤 반환 <- [배정확정]                                                                                                                                                                                                
             * .getModel("calc") : calc라는 이름의 모델을 가져옴                                                                                                                                                                                                          
             * calc JSON Model: 계산 결과와 상태를 메모리에 저장하고 공유                                                                                                                                                                                                        
             *&nbsp;                                                                                                                                                                                                                                           
             * mainfest.json에서 모델 등록 -> ProjectObjectPageExt.controller.js가 모델 수정 (공유 모델에 선택 상태 저장) ->  AssignStaff.js가 같은 모델에 계산 결과 저장                                                                                                                        
             */                                                                                                                                                                                                                                                
            // 1. 배정 확정 버튼 객체                                                                                                                                                                                                                                  
            const oButton = oEvent.getSource();                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 2. calc JSON Model                                                                                                                                                                                                                              
            const oCalcModel = oButton.getModel("calc");                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            if (!oCalcModel) {                                                                                                                                                                                                                                 
                MessageBox.error("배정안 계산 모델을 찾을 수 없습니다.");                                                                                                                                                                                                     
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 3. 계산 완료 및 배정 가능 여부 확인                                                                                                                                                                                                                          
            const bCalculated = oCalcModel.getProperty("/calculated");                                                                                                                                                                                         
            const bCanConfirm = oCalcModel.getProperty("/canConfirm");                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            if (!bCalculated || !bCanConfirm) {                                                                                                                                                                                                                
                MessageBox.warning("배정 가능한 계산 결과가 없습니다.");                                                                                                                                                                                                     
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            // 4. 계산 당시 프로젝트 번호와 직원번호                                                                                                                                                                                                                          
            const sProjectId = oCalcModel.getProperty("/projectId");                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            const aInstallPernrs =                                                                                                                                                                                                                             
                oCalcModel.getProperty("/installPernrs") || [];                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const aElecPernrs =                                                                                                                                                                                                                                
                oCalcModel.getProperty("/elecPernrs") || [];                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            if (                                                                                                                                                                                                                                               
                !sProjectId ||                                                                                                                                                                                                                                 
                aInstallPernrs.length === 0 ||                                                                                                                                                                                                                 
                aElecPernrs.length === 0                                                                                                                                                                                                                       
            ) {                                                                                                                                                                                                                                                
                MessageBox.warning("배정할 직원 정보를 확인해주세요.");                                                                                                                                                                                                      
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 5. 현재 Object Page의 OData Context                                                                                                                                                                                                                
            const oProjectContext = oButton.getBindingContext();                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            if (!oProjectContext) {                                                                                                                                                                                                                            
                MessageBox.error("현재 프로젝트의 OData Context를 찾을 수 없습니다.");                                                                                                                                                                                        
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 다른 프로젝트에서 계산한 결과를 사용하는지 방지                                                                                                                                                                                                                      
            if (oProjectContext.getProperty("ProjectId") !== sProjectId) {                                                                                                                                                                                     
                MessageBox.error("현재 프로젝트와 계산 결과의 프로젝트가 다릅니다.");                                                                                                                                                                                               
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // 6. 설치기사와 전기기사 직원번호 합치기                                                                                                                                                                                                                          
            // Set을 사용해 혹시 있을 수 있는 중복 직원번호 제거                                                                                                                                                                                                                  
            const aSelectedPernrs = [                                                                                                                                                                                                                          
                ...new Set([                                                                                                                                                                                                                                   
                    ...aInstallPernrs,                                                                                                                                                                                                                         
                    ...aElecPernrs                                                                                                                                                                                                                             
                ])                                                                                                                                                                                                                                             
            ];                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // 7. RAP Action의 _Members 파라미터 생성                                                                                                                                                                                                                 
            const aMembers = aSelectedPernrs.map(function (sPernr) {                                                                                                                                                                                           
                return {                                                                                                                                                                                                                                       
                    ProjectId: sProjectId,                                                                                                                                                                                                                     
                    PersonalNumber: sPernr                                                                                                                                                                                                                     
                };                                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 8. 사용자에게 최종 확인                                                                                                                                                                                                                                  
            MessageBox.confirm(                                                                                                                                                                                                                                
                "프로젝트: " + sProjectId +                                                                                                                                                                                                                        
                "\n설치기사: " + aInstallPernrs.length + "명" +                                                                                                                                                                                                     
                "\n전기기사: " + aElecPernrs.length + "명" +                                                                                                                                                                                                        
                "\n\n이 인력으로 배정을 확정하시겠습니까?",                                                                                                                                                                                                                    
                {                                                                                                                                                                                                                                              
                    title: "배정 확정",                                                                                                                                                                                                                            
                    actions: [                                                                                                                                                                                                                                 
                        MessageBox.Action.OK,                                                                                                                                                                                                                  
                        MessageBox.Action.CANCEL                                                                                                                                                                                                               
                    ],                                                                                                                                                                                                                                         
                    emphasizedAction: MessageBox.Action.OK,                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    onClose: async function (sAction) {                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                        // 취소를 누르면 백엔드 호출 없이 종료                                                                                                                                                                                                                
                        if (sAction !== MessageBox.Action.OK) {                                                                                                                                                                                                
                            return;                                                                                                                                                                                                                            
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        // 중복 클릭 방지                                                                                                                                                                                                                            
                        if (oButton.getBusy()) {                                                                                                                                                                                                               
                            return;                                                                                                                                                                                                                            
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        oButton.setBusy(true);                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                        try {                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                            // 9. 현재 프로젝트의 OData V4 Model                                                                                                                                                                                                      
                            const oModel = oProjectContext.getModel();                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                            // 10. RAP Bound Action 바인딩                                                                                                                                                                                                        
                            const oAction = oModel.bindContext(                                                                                                                                                                                                
                                "com.sap.gateway.srvd.z8ps_ui_staffing.v0001.confirmationAssignment(...)",                                                                                                                                                     
                                oProjectContext                                                                                                                                                                                                                
                            );                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                            // 11. RAP Action 파라미터 설정                                                                                                                                                                                                          
                            oAction.setParameter("ProjectId", sProjectId);                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                            oAction.setParameter("_Members", aMembers);                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                            // 12. 백엔드 Action 실행                                                                                                                                                                                                               
                            await oAction.execute();                                                                                                                                                                                                           
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                       
                                                                                                                                                                                                                                                               
                            // 13. 성공하면 기존 계산 상태 무효화                                                                                                                                                                                                           
                            oCalcModel.setProperty("/calculated", false);                                                                                                                                                                                      
                            oCalcModel.setProperty("/canConfirm", false);                                                                                                                                                                                      
                            oCalcModel.setProperty("/hasSelection", false);                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                            // OData Context 새로고침                                                                                                                                                                                                              
                            await oProjectContext.requestRefresh();                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                            MessageBox.success("인력 배정이 확정되었습니다.");                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                        } catch (oError) {                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                            console.error(                                                                                                                                                                                                                     
                                "[PS] 배정 확정 실패:",                                                                                                                                                                                                              
                                oError                                                                                                                                                                                                                         
                            );                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                            MessageBox.error(                                                                                                                                                                                                                  
                                "배정 확정 중 오류가 발생했습니다.\n\n" +                                                                                                                                                                                                    
                                (oError.message || String(oError))                                                                                                                                                                                             
                            );                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                        } finally {                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                            oButton.setBusy(false);                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                        }                                                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
            );                                                                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        isAssignStaffVisible: function (oBindingContext) {                                                                                                                                                                                                     
            if (!oBindingContext) {                                                                                                                                                                                                                            
                return false;                                                                                                                                                                                                                                  
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            return oBindingContext                                                                                                                                                                                                                             
                .requestProperty("ProjectStatus") // requestProperty()는 필요한 속성을 백엔드에서 추가로 요청                                                                                                                                                                   
